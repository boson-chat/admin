# Every variable the panel reads, with its default. See README.md.
# For local development use `make dev-env` instead (docker-compose.yml).

# development = console logs and allows an empty SESSION_KEY
ENV=production
LOG_LEVEL=info
# UI + /api
HTTP_ADDR=:8080
# /metrics, /healthz, /version; never publish
INTERNAL_ADDR=:8081
# State-changing requests must come from this origin
PUBLIC_URL=https://admin.example.com
# CIDRs whose X-Forwarded-For is trusted (the reverse proxy's container network)
TRUSTED_PROXIES=

# 32 bytes, base64 or hex: openssl rand -base64 32
SESSION_KEY=
# false only for plain-http dev
COOKIE_SECURE=true
# Absolute lifetime of a panel sign-in
SESSION_MAX_AGE=12h

# Auth service public API
AUTH_URL=http://auth:8080
# Auth internal listener (health; version via /metrics)
AUTH_INTERNAL_URL=http://auth:8081
# e.g. http://victoriametrics:8428; empty = no live numbers
METRICS_URL=
# e.g. https://grafana.example.com; empty = no links
GRAFANA_URL=
# name=url,...; empty = auth /healthz + /readyz from AUTH_INTERNAL_URL
HEALTH_TARGETS=
# name=url,...; empty = auth from AUTH_INTERNAL_URL/metrics
VERSION_TARGETS=
# host:port[@dial-host:dial-port],...
TLS_CHECK_HOSTS=
UPSTREAM_TIMEOUT=5s
# IRC probe: ircs://host[:6697] or irc://host[:6667]; empty = not configured
IRC_CHECK=
# TLS SNI for the IRC probe (defaults to IRC_CHECK's host)
IRC_CHECK_SERVER_NAME=
# name=url,... public endpoints timed from the admin's browser (https/http/wss/ws);
# their origins are added to the CSP connect-src
PUBLIC_PROBE_TARGETS=
# The reverse proxy's name on the stack view
EDGE_NAME=Traefik

# Services control through a Docker socket proxy (never the socket itself);
# empty = off. See README "Services control".
DOCKER_PROXY_URL=
DOCKER_PROJECT=boson
DOCKER_PROTECTED_SERVICES=admin,traefik
DOCKER_TIMEOUT=20s
# The stack's boson API for users' profiles (e.g. http://api:3000); empty = off
BOSON_API_URL=
BOSON_CDN_URL=https://cdn.boson.chat
# The public directory; empty = the directory page is off
DIRECTORY_API_URL=https://api.boson.chat
# Self-hosted registration (needs the new directory API)
DIRECTORY_REGISTRATION=false
# Secret for the directory management key (defaults to SESSION_KEY)
DIRECTORY_KEY=
# IRC hostname to list (defaults to IRC_CHECK_SERVER_NAME)
DIRECTORY_HOSTNAME=

# OTLP metrics push (optional; /metrics on INTERNAL_ADDR is always served)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_METRICS_EXPORTER=
